{
  "editor.fontFamily": "'FiraCode Nerd Font Mono', 'Agave Nerd Font Mono', 'CaskaydiaMono Nerd Font Mono', 'DaddyTimeMono Nerd Font Mono', 'Mononoki Nerd Font Mono', Consolas, 'Courier New', monospace",
  "editor.fontSize": 15,
  "editor.lineHeight": 18,
  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.formatOnSave": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.stickyScroll.enabled": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "expand",
  "editor.linkedEditing": true,
  "editor.guides.bracketPairs": true,
  "notebook.breadcrumbs.showCodeCells": false,
  "terminal.integrated.fontSize": 16,
  "files.insertFinalNewline": true,
  "zenMode.centerLayout": false,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.sideBar.location": "right",
  "workbench.editor.showTabs": "single",
  "workbench.colorTheme": "One Dark Pro Darker",
  "synthwave84.disableGlow": false,
  "workbench.preferredDarkColorTheme": "One Dark Pro Darker",
  "git.openRepositoryInParentFolders": "never",
  "oneDarkPro.vivid": true,
  "oneDarkPro.bold": true,
  "editor.rulers": [80],
  "editor.tokenColorCustomizations": {
    "[One Dark Pro Darker]": {
      "variables": "#ABB2BF",
      "textMateRules": [
        {
          "scope": [
            "keyword.operator",
            "keyword.operator.arithmetic",
            "keyword.operator.assignment",
            "keyword.operator.logical",
            "keyword.operator.new",
            "keyword.operator.comparison"
          ],
          "settings": {
            "foreground": "#56B6C2"
          }
        },
        {
          "scope": [
            "comment",
            "keyword.control",
            "keyword.other",
            "storage.type.functions.js",
            "storage.modifier.async.js",
            "storage.type.js"
          ],
          "settings": {
            "fontStyle": "italic"
          }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "*.mutable": {
        "underline": false
      }
    },
    "[One Dark Pro Darker]": {
      "rules": {
        "property": "#d83341",
        "variable": "#ABB2BF"
      }
    }
  },
  "editor.fontLigatures": true,
  "[python]": {
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-python.autopep8"
  },
  "security.workspace.trust.banner": "never",
  "workbench.editorAssociations": {
    "*.dll": "default"
  },
  "explorer.confirmDelete": false,
  "window.menuBarVisibility": "toggle",
  "workbench.layoutControl.enabled": false,
  "workbench.statusBar.visible": false,
  "oneDarkPro.editorTheme": "One Dark Pro Darker",
  "git.autofetch": true,
  "security.workspace.trust.untrustedFiles": "open",
  "editor.cursorStyle": "line-thin"
}
